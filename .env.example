# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Get your key from https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# Primary model for email generation and analysis
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Fallback model if primary fails or times out
FALLBACK_LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Embedding model for semantic search (ChromaDB)
EMBED_MODEL=BAAI/bge-large-en-v1.5

# ── Web Enrichment ────────────────────────────────────────────────────────────
# Serper: https://serper.dev  (Google search API)
SERPER_API_KEY=your_serper_api_key_here

# Tavily: https://app.tavily.com  (AI search API)
TAVILY_API_KEY=your_tavily_api_key_here

# ── SMTP (Email Sending) ──────────────────────────────────────────────────────
# For Gmail: use an App Password (not your login password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
FROM_NAME=Your Name
